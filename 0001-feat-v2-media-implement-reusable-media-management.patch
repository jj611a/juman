+  UPLOAD: 'media.upload',
+  DELETE: 'media.delete',
+  MANAGE: 'media.manage',
+  RESTORE: 'media.restore',
+} as const;
+
+/** Top-level folders under the configured storage root. */
+export const MEDIA_STORAGE_CATEGORY = {
+  IMAGES: 'images',
+  DOCUMENTS: 'documents',
