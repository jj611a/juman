diff --git a/backend-node/src/inventory/brands/brands.controller.ts b/backend-node/src/inventory/brands/brands.controller.ts
new file mode 100644
index 0000000..588ecf4
--- /dev/null
+++ b/backend-node/src/inventory/brands/brands.controller.ts
@@ -0,0 +1,69 @@
+import {
+  Body,
+  Controller,
+  Delete,
+  Get,
+  HttpCode,
+  Param,
+  ParseUUIDPipe,
+  Patch,
+  Post,
+  Query,
+} from '@nestjs/common';
+import { CurrentUser } from '../../auth/decorators/current-user.decorator';
+import { RequirePermissions } from '../../auth/decorators/require-permissions.decorator';
+import type { AuthPrincipal } from '../../shared/types';
+import { INVENTORY_PERMISSION } from '../inventory.constants';
+import { BrandsService } from './brands.service';
+import { BrandDto, ListBrandsDto } from './dto/brand.dto';
+
+@Controller('brands')
+export class BrandsController {
+  constructor(private readonly service: BrandsService) {}
+
+  @Get()
+  @RequirePermissions(INVENTORY_PERMISSION.VIEW)
+  list(@Query() q: ListBrandsDto) {
+    return this.service.list(q);
+  }
+
+  @Get(':id')
+  @RequirePermissions(INVENTORY_PERMISSION.VIEW)
+  get(@Param('id', ParseUUIDPipe) id: string) {
+    return this.service.getById(id);
+  }
+
+  @Post()
+  @RequirePermissions(INVENTORY_PERMISSION.CREATE)
+  create(@Body() d: BrandDto, @CurrentUser() u: AuthPrincipal) {
+    return this.service.create(d, u);
+  }
+
+  @Patch(':id')
+  @RequirePermissions(INVENTORY_PERMISSION.UPDATE)
+  update(
+    @Param('id', ParseUUIDPipe) id: string,
+    @Body() d: BrandDto,
+    @CurrentUser() u: AuthPrincipal,
+  ) {
+    return this.service.update(id, d, u);
+  }
+  @Delete(':id')
+  @HttpCode(200)
+  @RequirePermissions(INVENTORY_PERMISSION.DELETE)
+  delete(
+    @Param('id', ParseUUIDPipe) id: string,
+    @CurrentUser() u: AuthPrincipal,
+  ) {
+    return this.service.softDelete(id, u);
+  }
+  @Post(':id/restore')
+  @HttpCode(200)
+  @RequirePermissions(INVENTORY_PERMISSION.RESTORE)
+  restore(
+    @Param('id', ParseUUIDPipe) id: string,
+    @CurrentUser() u: AuthPrincipal,
+  ) {
+    return this.service.restore(id, u);
+  }
+}
