# Copied into config/juman.env on first startup when missing.
# Prefer editing config/juman.env under JUMAN_DATA_DIR (repo root by default).

APP_NAME=Juman
APP_ENV=development
APP_VERSION=2.0.0
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info
# DATABASE_URL and JUMAN_DATA_DIR are generated automatically when omitted.

# Auth (JWT_SECRET auto-generated on first juman.env create; required in production)
# JWT_SECRET=
JWT_ISSUER=juman
JWT_AUDIENCE=juman-desktop
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_REFRESH_TOKEN_EXPIRE_DAYS=30
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=1
MAX_FAILED_LOGIN_ATTEMPTS=5
# Timed lockout (minutes). 0 = permanent until admin unlock — not recommended.
ACCOUNT_LOCK_DURATION_MINUTES=15
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_COMPLEXITY=true
PASSWORD_HISTORY_COUNT=5

# Optional first Administrator (defaults: admin / Juman!Bootstrap1 with mustChangePassword)
# IDENTITY_BOOTSTRAP_USERNAME=admin
# IDENTITY_BOOTSTRAP_PASSWORD=Juman!Bootstrap1
