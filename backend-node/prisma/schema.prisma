generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  passwordHash         String
  fullName             String
  phone                String?
  email                String?
  roleId               String
  isActive             Boolean   @default(true)
  isLocked             Boolean   @default(false)
  mustChangePassword   Boolean   @default(true)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?

  role            Role             @relation(fields: [roleId], references: [id])
  sessions        LoginSession[]
  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  passwordHistory PasswordHistory[]

  @@index([roleId])
  @@index([deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String    @id @default(uuid())
  key         String    @unique
  displayName String
  description String?
  module      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model LoginSession {
  id             String    @id @default(uuid())
  userId         String
  deviceName     String?
  ipAddress      String?
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?
  rememberMe     Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  sessionId    String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id])
  session LoginSession @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model LoginHistory {
  id                String   @id @default(uuid())
  userId            String?
  usernameAttempted String
  eventType         String
  success           Boolean
  failureReason     String?
  ipAddress         String?
  deviceName        String?
  userAgent         String?
  sessionId         String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AppSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  valueType   String    @default("string")
  category    String
  description String?
  isEditable  Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([category])
  @@index([deletedAt])
}

model MediaFile {
  id               String    @id @default(uuid())
  originalFilename String
  storedFilename   String
  extension        String
  mimeType         String
  sizeBytes        Int
  sha256Hash       String
  width            Int?
  height           Int?
  orientation      Int?
  storageProvider  String    @default("local")
  relativePath     String
  kind             String
  isPublic         Boolean   @default(false)
  uploadedBy       String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?

  references MediaReference[]

  @@index([sha256Hash])
  @@index([kind])
  @@index([extension])
  @@index([mimeType])
  @@index([deletedAt])
  @@index([createdAt])
}

model MediaReference {
  id           String    @id @default(uuid())
  mediaFileId  String
  moduleName   String
  entityType   String
  entityId     String
  purpose      String
  displayOrder Int       @default(0)
  isPrimary    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@index([moduleName, entityType, entityId])
  @@index([mediaFileId])
  @@index([purpose])
  @@index([deletedAt])
}

/// Reusable barcode registry (domains bind via entityType/entityId ? no inventory logic here).
model Barcode {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String    @default("code128")
  prefix      String
  status      String
  entityType  String?
  entityId    String?
  reservedAt  DateTime?
  activatedAt DateTime?
  retiredAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  itemBarcodes ItemBarcode[]

  @@index([prefix])
  @@index([status])
  @@index([type])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@index([createdAt])
}

model SequenceCounter {
  prefix    String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Append-only domain audit trail. Write only via AuditService.record.
model AuditLog {
  id         String   @id @default(uuid())
  module     String
  entityType String
  entityId   String?
  action     String
  oldValues  String?
  newValues  String?
  userId     String?
  username   String?
  ipAddress  String?
  metadata   String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model Customer {
  id              String    @id @default(uuid())
  customerNumber  String    @unique
  fullName        String
  phone           String
  phoneNormalized String
  secondaryPhone  String?
  secondaryPhoneNormalized String?
  address         String?
  city            String?
  nationalId      String?
  gender          String?
  birthDate       DateTime?
  notes           String?
  status          String    @default("active")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedBy       String?

  rentals Rental[]

  @@index([fullName])
  @@index([phoneNormalized])
  @@index([secondaryPhoneNormalized])
  @@index([nationalId])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, phoneNormalized, deletedAt])
}

/// Catalog taxonomy: tree-ready via optional parentId (Phase 4.1).
model Category {
  id          String    @id @default(uuid())
  name        String
  nameEn      String?
  description String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  items    Item[]

  @@index([name])
  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([sortOrder])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  items Item[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
}

model Color {
  id          String    @id @default(uuid())
  name        String
  hexCode     String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  items Item[]

  @@index([name])
  @@index([hexCode])
  @@index([isActive])
  @@index([deletedAt])
}

model Size {
  id          String    @id @default(uuid())
  name        String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  items Item[]

  @@index([name])
  @@index([sortOrder])
  @@index([isActive])
  @@index([deletedAt])
}

/// Generic catalog item (frontend may label as Dress; backend stays type-agnostic).
model Item {
  id            String    @id @default(uuid())
  internalCode  String    @unique
  displayName   String
  categoryId    String?
  brandId       String?
  colorId       String?
  sizeId        String?
  purchasePrice Int       @default(0)
  rentalPrice   Int       @default(0)
  salePrice     Int       @default(0)
  condition     String?
  status        String    @default("draft")
  lifecycleState String   @default("available")
  /** Catalog status captured at soft-delete; restored on undelete. */
  statusBeforeDelete String?
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedBy     String?

  category Category? @relation(fields: [categoryId], references: [id])
  brand    Brand?    @relation(fields: [brandId], references: [id])
  color    Color?    @relation(fields: [colorId], references: [id])
  size     Size?     @relation(fields: [sizeId], references: [id])
  barcodes ItemBarcode[]
  stateHistory ItemStateHistory[]
  rentalItems RentalItem[]

  @@index([displayName])
  @@index([internalCode])
  @@index([categoryId])
  @@index([brandId])
  @@index([colorId])
  @@index([sizeId])
  @@index([status])
  @@index([lifecycleState])
  @@index([condition])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, deletedAt])
  @@index([lifecycleState, deletedAt])
}

/// Append-only operational lifecycle transitions (Phase 4.2).
model ItemStateHistory {
  id               String   @id @default(uuid())
  itemId           String
  oldState         String
  newState         String
  reason           String?
  userId           String?
  username         String?
  referenceType    String?
  referenceId      String?
  createdAt        DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([newState])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model ItemBarcode {
  id         String    @id @default(uuid())
  itemId     String
  barcodeId  String    @unique
  isPrimary  Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?

  item    Item    @relation(fields: [itemId], references: [id])
  barcode Barcode @relation(fields: [barcodeId], references: [id])

  @@index([itemId])
  @@index([barcodeId])
  @@index([deletedAt])
}

/// Rental workflow document (Phase 5.1) — inventory lifecycle owned by LifecycleService.
model Rental {
  id                  String    @id @default(uuid())
  rentalNumber        String    @unique
  customerId          String
  rentalDate          DateTime
  expectedReturnDate  DateTime
  actualReturnDate    DateTime?
  status              String    @default("draft")
  notes               String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedBy           String?

  customer      Customer               @relation(fields: [customerId], references: [id])
  items         RentalItem[]
  statusHistory RentalStatusHistory[]

  @@index([customerId])
  @@index([rentalNumber])
  @@index([status])
  @@index([rentalDate])
  @@index([expectedReturnDate])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([status, deletedAt])
}

model RentalItem {
  id                 String   @id @default(uuid())
  rentalId           String
  itemId             String
  barcodeValue       String?
  agreedRentalPrice  Int      @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  rental Rental @relation(fields: [rentalId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([rentalId, itemId])
  @@index([rentalId])
  @@index([itemId])
  @@index([barcodeValue])
}

model RentalStatusHistory {
  id        String   @id @default(uuid())
  rentalId  String
  oldStatus String
  newStatus String
  reason    String?
  userId    String?
  username  String?
  createdAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@index([newStatus])
  @@index([createdAt])
}
