generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  passwordHash         String
  fullName             String
  phone                String?
  email                String?
  roleId               String
  isActive             Boolean   @default(true)
  isLocked             Boolean   @default(false)
  mustChangePassword   Boolean   @default(true)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?

  role            Role             @relation(fields: [roleId], references: [id])
  sessions        LoginSession[]
  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  passwordHistory PasswordHistory[]

  @@index([roleId])
  @@index([deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String    @id @default(uuid())
  key         String    @unique
  displayName String
  description String?
  module      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model LoginSession {
  id             String    @id @default(uuid())
  userId         String
  deviceName     String?
  ipAddress      String?
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?
  rememberMe     Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  sessionId    String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id])
  session LoginSession @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model LoginHistory {
  id                String   @id @default(uuid())
  userId            String?
  usernameAttempted String
  eventType         String
  success           Boolean
  failureReason     String?
  ipAddress         String?
  deviceName        String?
  userAgent         String?
  sessionId         String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AppSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  valueType   String    @default("string")
  category    String
  description String?
  isEditable  Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([category])
  @@index([deletedAt])
}

model MediaFile {
  id               String    @id @default(uuid())
  originalFilename String
  storedFilename   String
  extension        String
  mimeType         String
  sizeBytes        Int
  sha256Hash       String
  width            Int?
  height           Int?
  orientation      Int?
  storageProvider  String    @default("local")
  relativePath     String
  kind             String
  isPublic         Boolean   @default(false)
  uploadedBy       String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?

  references MediaReference[]

  @@index([sha256Hash])
  @@index([kind])
  @@index([extension])
  @@index([mimeType])
  @@index([deletedAt])
  @@index([createdAt])
}

model MediaReference {
  id           String    @id @default(uuid())
  mediaFileId  String
  moduleName   String
  entityType   String
  entityId     String
  purpose      String
  displayOrder Int       @default(0)
  isPrimary    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@index([moduleName, entityType, entityId])
  @@index([mediaFileId])
  @@index([purpose])
  @@index([deletedAt])
}

/// Reusable barcode registry (domains bind via entityType/entityId ? no inventory logic here).
model Barcode {
  id          String    @id @default(uuid())
  code        String    @unique
  type        String    @default("code128")
  prefix      String
  status      String
  entityType  String?
  entityId    String?
  reservedAt  DateTime?
  activatedAt DateTime?
  retiredAt   DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  itemBarcodes ItemBarcode[]

  @@index([prefix])
  @@index([status])
  @@index([type])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@index([createdAt])
}

model SequenceCounter {
  prefix    String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Append-only domain audit trail. Write only via AuditService.record.
model AuditLog {
  id         String   @id @default(uuid())
  module     String
  entityType String
  entityId   String?
  action     String
  oldValues  String?
  newValues  String?
  userId     String?
  username   String?
  ipAddress  String?
  metadata   String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

model Customer {
  id              String    @id @default(uuid())
  customerNumber  String    @unique
  fullName        String
  phone           String
  phoneNormalized String
  secondaryPhone  String?
  secondaryPhoneNormalized String?
  address         String?
  city            String?
  nationalId      String?
  gender          String?
  birthDate       DateTime?
  notes           String?
  status          String    @default("active")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedBy       String?

  rentals Rental[]
  reservations Reservation[]
  sales Sale[]
  financialAccounts FinancialAccount[]

  @@index([fullName])
  @@index([phoneNormalized])
  @@index([secondaryPhoneNormalized])
  @@index([nationalId])
  @@index([city])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, phoneNormalized, deletedAt])
}

/// Catalog taxonomy: tree-ready via optional parentId (Phase 4.1).
model Category {
  id          String    @id @default(uuid())
  name        String
  nameEn      String?
  description String?
  parentId    String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  items    Item[]

  @@index([name])
  @@index([parentId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([sortOrder])
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  items Item[]

  @@index([name])
  @@index([isActive])
  @@index([deletedAt])
}

model Color {
  id          String    @id @default(uuid())
  name        String
  hexCode     String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  items Item[]

  @@index([name])
  @@index([hexCode])
  @@index([isActive])
  @@index([deletedAt])
}

model Size {
  id          String    @id @default(uuid())
  name        String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedBy   String?

  items Item[]

  @@index([name])
  @@index([sortOrder])
  @@index([isActive])
  @@index([deletedAt])
}

/// Generic catalog item (frontend may label as Dress; backend stays type-agnostic).
model Item {
  id            String    @id @default(uuid())
  internalCode  String    @unique
  displayName   String
  categoryId    String?
  brandId       String?
  colorId       String?
  sizeId        String?
  purchasePrice Int       @default(0)
  rentalPrice   Int       @default(0)
  salePrice     Int       @default(0)
  condition     String?
  status        String    @default("draft")
  lifecycleState String   @default("available")
  /** Catalog status captured at soft-delete; restored on undelete. */
  statusBeforeDelete String?
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedBy     String?

  category Category? @relation(fields: [categoryId], references: [id])
  brand    Brand?    @relation(fields: [brandId], references: [id])
  color    Color?    @relation(fields: [colorId], references: [id])
  size     Size?     @relation(fields: [sizeId], references: [id])
  barcodes ItemBarcode[]
  stateHistory ItemStateHistory[]
  rentalItems RentalItem[]
  reservationItems ReservationItem[]
  saleItems SaleItem[]

  @@index([displayName])
  @@index([internalCode])
  @@index([categoryId])
  @@index([brandId])
  @@index([colorId])
  @@index([sizeId])
  @@index([status])
  @@index([lifecycleState])
  @@index([condition])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([status, deletedAt])
  @@index([lifecycleState, deletedAt])
}

/// Append-only operational lifecycle transitions (Phase 4.2).
model ItemStateHistory {
  id               String   @id @default(uuid())
  itemId           String
  oldState         String
  newState         String
  reason           String?
  userId           String?
  username         String?
  referenceType    String?
  referenceId      String?
  createdAt        DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([newState])
  @@index([createdAt])
  @@index([referenceType, referenceId])
}

model ItemBarcode {
  id         String    @id @default(uuid())
  itemId     String
  barcodeId  String    @unique
  isPrimary  Boolean   @default(true)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?

  item    Item    @relation(fields: [itemId], references: [id])
  barcode Barcode @relation(fields: [barcodeId], references: [id])

  @@index([itemId])
  @@index([barcodeId])
  @@index([deletedAt])
}

/// Rental workflow document (Phase 5.1) — inventory lifecycle owned by LifecycleService.
model Rental {
  id                  String    @id @default(uuid())
  rentalNumber        String    @unique
  customerId          String
  reservationId       String?   @unique
  rentalDate          DateTime
  expectedReturnDate  DateTime
  actualReturnDate    DateTime?
  status              String    @default("draft")
  notes               String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedBy           String?

  customer      Customer               @relation(fields: [customerId], references: [id])
  reservation   Reservation?           @relation(fields: [reservationId], references: [id])
  items         RentalItem[]
  statusHistory RentalStatusHistory[]
  settlement    RentalSettlement?

  @@index([customerId])
  @@index([reservationId])
  @@index([rentalNumber])
  @@index([status])
  @@index([rentalDate])
  @@index([expectedReturnDate])
  @@index([actualReturnDate])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([status, deletedAt])
}

model RentalItem {
  id                 String   @id @default(uuid())
  rentalId           String
  itemId             String
  barcodeValue       String?
  agreedRentalPrice  Int      @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  rental Rental @relation(fields: [rentalId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  @@unique([rentalId, itemId])
  @@index([rentalId])
  @@index([itemId])
  @@index([barcodeValue])
}

model RentalStatusHistory {
  id        String   @id @default(uuid())
  rentalId  String
  oldStatus String
  newStatus String
  reason    String?
  userId    String?
  username  String?
  createdAt DateTime @default(now())

  rental Rental @relation(fields: [rentalId], references: [id])

  @@index([rentalId])
  @@index([newStatus])
  @@index([createdAt])
}

/// Reservation document (Phase 5.2) — independent from Rental; checkout materializes a Rental.
model Reservation {
  id                   String    @id @default(uuid())
  reservationNumber    String    @unique
  customerId           String
  startDate            DateTime
  expectedCheckoutDate DateTime
  expectedReturnDate   DateTime
  status               String    @default("draft")
  notes                String?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?
  deletedBy            String?

  customer      Customer                   @relation(fields: [customerId], references: [id])
  items         ReservationItem[]
  statusHistory ReservationStatusHistory[]
  rental        Rental?

  @@index([customerId])
  @@index([reservationNumber])
  @@index([status])
  @@index([startDate])
  @@index([expectedCheckoutDate])
  @@index([expectedReturnDate])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([status, deletedAt])
  @@index([startDate, expectedReturnDate])
}

model ReservationItem {
  id                 String   @id @default(uuid())
  reservationId      String
  itemId             String
  barcodeValue       String?
  agreedRentalPrice  Int      @default(0)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdBy          String?

  reservation Reservation @relation(fields: [reservationId], references: [id])
  item        Item        @relation(fields: [itemId], references: [id])

  @@unique([reservationId, itemId])
  @@index([reservationId])
  @@index([itemId])
  @@index([barcodeValue])
}

model ReservationStatusHistory {
  id            String   @id @default(uuid())
  reservationId String
  oldStatus     String
  newStatus     String
  reason        String?
  userId        String?
  username      String?
  createdAt     DateTime @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId])
  @@index([newStatus])
  @@index([createdAt])
}

/// Customer financial ledger (Phase 6.1). Balances are never stored — computed from transactions.
model FinancialAccount {
  id            String    @id @default(uuid())
  accountNumber String    @unique
  customerId    String
  currency      String    @default("IQD")
  status        String    @default("open")
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedBy     String?

  customer     Customer               @relation(fields: [customerId], references: [id])
  transactions FinancialTransaction[]
  payments     Payment[]
  movements    MoneyMovement[]
  settlements  RentalSettlement[]

  @@unique([customerId])
  @@index([accountNumber])
  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
}

/// Posted ledger entry. Amounts are integer fils (IQD only).
model FinancialTransaction {
  id            String   @id @default(uuid())
  accountId     String
  type          String
  /// Positive fils; effect on outstanding is defined by type (see FinancialDesign).
  amountFils    Int
  status        String   @default("posted")
  referenceType String?
  referenceId   String?
  /// Owning settlement when this entry is part of a rental obligation (Phase 6.5).
  settlementId  String?
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?

  account    FinancialAccount  @relation(fields: [accountId], references: [id])
  settlement RentalSettlement? @relation(fields: [settlementId], references: [id])
  payment    Payment?
  movements  MoneyMovement[]

  @@unique([type, referenceType, referenceId])
  @@index([accountId])
  @@index([type])
  @@index([status])
  @@index([referenceType, referenceId])
  @@index([settlementId])
  @@index([createdAt])
  @@index([status, type, createdAt])
}

/// Payment document (Phase 6.1). Does not mutate rental rows.
model Payment {
  id            String    @id @default(uuid())
  paymentNumber String    @unique
  accountId     String
  settlementId  String?
  transactionId String?   @unique
  amountFils    Int
  status        String    @default("pending")
  method        String    @default("cash")
  notes         String?
  completedAt   DateTime?
  cancelledAt   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedBy     String?

  account     FinancialAccount      @relation(fields: [accountId], references: [id])
  settlement  RentalSettlement?     @relation(fields: [settlementId], references: [id])
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id])
  movements   MoneyMovement[]
  historyLinks SettlementHistory[]

  @@index([accountId])
  @@index([settlementId])
  @@index([paymentNumber])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([completedAt])
  @@index([status, completedAt])
}

/// Immutable money movement trail linked to account / payment / transaction.
model MoneyMovement {
  id            String   @id @default(uuid())
  accountId     String
  paymentId     String?
  transactionId String?
  /// in = reduces outstanding; out = increases outstanding (obligation).
  direction     String
  amountFils    Int
  currency      String   @default("IQD")
  kind          String
  createdAt     DateTime @default(now())
  createdBy     String?

  account     FinancialAccount      @relation(fields: [accountId], references: [id])
  payment     Payment?              @relation(fields: [paymentId], references: [id])
  transaction FinancialTransaction? @relation(fields: [transactionId], references: [id])

  @@index([accountId])
  @@index([paymentId])
  @@index([transactionId])
  @@index([direction])
  @@index([kind])
  @@index([createdAt])
}

/// Finance-domain audit (append-only). Complements platform AuditService.
model FinancialAudit {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  action     String
  oldValues  String?
  newValues  String?
  userId     String?
  username   String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}

/// Polymorphic financial obligation tracker (Phase 6.2+ / 6.7). SettlementService alone decides completion.
/// entityType+entityId is source of truth; rentalId kept for rental back-compat (nullable for sales).
model RentalSettlement {
  id               String    @id @default(uuid())
  settlementNumber String    @unique
  /// rental | sale
  entityType       String    @default("rental")
  entityId         String
  /// Legacy FK — set when entityType=rental; null for sales.
  rentalId         String?   @unique
  /// Convenience FK when entityType=sale; null for rentals.
  saleId           String?   @unique
  accountId        String
  customerId       String
  /// Gross charge (fils) before deposit / modifiers.
  chargeFils       Int       @default(0)
  /// Deposit applied at checkout — reduces effective charges (not a Payment).
  depositFils      Int       @default(0)
  /// Sum of posted late fees.
  lateFeeFils      Int       @default(0)
  /// Signed net of posted adjustments (positive increases obligation).
  adjustmentFils   Int       @default(0)
  /// Sum of posted discounts.
  discountFils     Int       @default(0)
  /// Sum of posted refunds (credit notes — reduce obligation).
  refundFils       Int       @default(0)
  /// Computed: (charge−deposit)+late+adjustment−discount−refund.
  totalFils        Int
  paidFils         Int       @default(0)
  remainingFils    Int
  status           String    @default("open")
  currency         String    @default("IQD")
  notes            String?
  closedAt         DateTime?
  cancelledAt      DateTime?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedBy        String?

  rental       Rental?                 @relation(fields: [rentalId], references: [id])
  sale         Sale?                   @relation(fields: [saleId], references: [id])
  account      FinancialAccount        @relation(fields: [accountId], references: [id])
  history      SettlementHistory[]
  transactions FinancialTransaction[]
  payments     Payment[]
  refunds      SettlementRefund[]
  adjustments  SettlementAdjustment[]
  discounts    SettlementDiscount[]
  lateFees     SettlementLateFee[]

  @@unique([entityType, entityId])
  @@index([settlementNumber])
  @@index([entityType, entityId])
  @@index([rentalId])
  @@index([saleId])
  @@index([accountId])
  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([status, deletedAt])
}

/// Permanent sale document (Phase 6.7) — inventory sold via LifecycleService; money via Settlement.
model Sale {
  id           String    @id @default(uuid())
  saleNumber   String    @unique
  /// Null = Walk-in system customer at finance time.
  customerId   String?
  status       String    @default("draft")
  subtotalFils Int       @default(0)
  discountFils Int       @default(0)
  taxFils      Int       @default(0)
  totalFils    Int       @default(0)
  notes        String?
  completedAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedBy    String?

  customer   Customer?     @relation(fields: [customerId], references: [id])
  items      SaleItem[]
  history    SaleHistory[]
  settlement RentalSettlement?

  @@index([saleNumber])
  @@index([customerId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([completedAt])
  @@index([status, deletedAt])
}

model SaleItem {
  id               String   @id @default(uuid())
  saleId           String
  itemId           String
  priceFils        Int      @default(0)
  discountFils     Int      @default(0)
  /// Future-proof; Phase 6.7 enforces quantity = 1 (one physical Item).
  quantity         Int      @default(1)
  totalFils        Int      @default(0)
  barcodeSnapshot  String?
  itemNameSnapshot String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdBy        String?

  sale Sale @relation(fields: [saleId], references: [id])
  item Item @relation(fields: [itemId], references: [id])

  @@unique([saleId, itemId])
  @@index([saleId])
  @@index([itemId])
  @@index([barcodeSnapshot])
}

model SaleHistory {
  id        String   @id @default(uuid())
  saleId    String
  oldStatus String
  newStatus String
  action    String
  reason    String?
  userId    String?
  username  String?
  createdAt DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id])

  @@index([saleId])
  @@index([action])
  @@index([newStatus])
  @@index([createdAt])
}

/// Append-only settlement status / payment / modifier history.
model SettlementHistory {
  id           String   @id @default(uuid())
  settlementId String
  oldStatus    String
  newStatus    String
  action       String
  amountFils   Int?
  paymentId    String?
  reason       String?
  userId       String?
  username     String?
  createdAt    DateTime @default(now())

  settlement RentalSettlement @relation(fields: [settlementId], references: [id])
  payment    Payment?         @relation(fields: [paymentId], references: [id])

  @@index([settlementId])
  @@index([action])
  @@index([paymentId])
  @@index([newStatus])
  @@index([createdAt])
}

/// Credit-note refund against a settlement (Phase 6.6). Never mutates Payment rows.
model SettlementRefund {
  id             String    @id @default(uuid())
  refundNumber   String    @unique
  settlementId   String
  amountFils     Int
  reason         String
  status         String    @default("posted")
  transactionId  String?   @unique
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  settlement  RentalSettlement         @relation(fields: [settlementId], references: [id])
  history     SettlementRefundHistory[]

  @@index([settlementId])
  @@index([refundNumber])
  @@index([status])
  @@index([createdAt])
}

model SettlementRefundHistory {
  id         String   @id @default(uuid())
  refundId   String
  oldStatus  String
  newStatus  String
  action     String
  reason     String?
  userId     String?
  username   String?
  createdAt  DateTime @default(now())

  refund SettlementRefund @relation(fields: [refundId], references: [id])

  @@index([refundId])
  @@index([action])
  @@index([createdAt])
}

/// Signed settlement adjustment (Phase 6.6).
model SettlementAdjustment {
  id            String    @id @default(uuid())
  settlementId  String
  /// Signed fils — positive increases obligation; negative decreases.
  amountFils    Int
  reason        String
  status        String    @default("posted")
  transactionId String?   @unique
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?

  settlement RentalSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@index([status])
  @@index([createdAt])
}

/// Settlement / rental-level discount (Phase 6.6).
model SettlementDiscount {
  id            String    @id @default(uuid())
  settlementId  String
  /// percentage | fixed
  kind          String
  /// rental | settlement
  basis         String    @default("settlement")
  /// Basis points (10000 = 100%) when kind=percentage.
  percentBps    Int?
  /// Fixed fils when kind=fixed.
  amountFils    Int?
  /// Computed fils actually applied.
  computedFils  Int
  reason        String
  status        String    @default("posted")
  transactionId String?   @unique
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?

  settlement RentalSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

/// Late fee assessment foundation — domain only, no scheduler (Phase 6.6).
model SettlementLateFee {
  id            String    @id @default(uuid())
  settlementId  String
  /// flat | daily
  kind          String
  flatFils      Int?
  dailyFils     Int?
  maxFils       Int?
  daysCharged   Int?
  computedFils  Int
  reason        String
  status        String    @default("posted")
  assessedAt    DateTime  @default(now())
  transactionId String?   @unique
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?

  settlement RentalSettlement @relation(fields: [settlementId], references: [id])

  @@index([settlementId])
  @@index([kind])
  @@index([status])
  @@index([assessedAt])
  @@index([createdAt])
}

/// Client/request idempotency for finance mutations (Phase 6.5).
model FinanceIdempotencyKey {
  id           String   @id @default(uuid())
  scope        String
  key          String
  requestHash  String?
  resourceType String?
  resourceId   String?
  status       String   @default("completed")
  responseJson String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([scope, key])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}
