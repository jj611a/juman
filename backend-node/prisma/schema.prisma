generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AppMeta {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String
}

model User {
  id                   String    @id @default(uuid())
  username             String    @unique
  passwordHash         String
  fullName             String
  phone                String?
  email                String?
  roleId               String
  isActive             Boolean   @default(true)
  isLocked             Boolean   @default(false)
  mustChangePassword   Boolean   @default(true)
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  lastLoginAt          DateTime?
  passwordChangedAt    DateTime?
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?

  role            Role             @relation(fields: [roleId], references: [id])
  sessions        LoginSession[]
  refreshTokens   RefreshToken[]
  loginHistory    LoginHistory[]
  passwordHistory PasswordHistory[]

  @@index([roleId])
  @@index([deletedAt])
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isSystem    Boolean   @default(false)
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users           User[]
  rolePermissions RolePermission[]
}

model Permission {
  id          String    @id @default(uuid())
  key         String    @unique
  displayName String
  description String?
  module      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model LoginSession {
  id             String    @id @default(uuid())
  userId         String
  deviceName     String?
  ipAddress      String?
  lastActivityAt DateTime
  expiresAt      DateTime
  revokedAt      DateTime?
  revokedBy      String?
  rememberMe     Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id])
  refreshTokens RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  sessionId    String
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user    User         @relation(fields: [userId], references: [id])
  session LoginSession @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model LoginHistory {
  id                String   @id @default(uuid())
  userId            String?
  usernameAttempted String
  eventType         String
  success           Boolean
  failureReason     String?
  ipAddress         String?
  deviceName        String?
  userAgent         String?
  sessionId         String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([eventType])
}

model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AppSetting {
  id          String    @id @default(uuid())
  key         String    @unique
  value       String
  valueType   String    @default("string")
  category    String
  description String?
  isEditable  Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([category])
  @@index([deletedAt])
}

model MediaFile {
  id               String    @id @default(uuid())
  originalFilename String
  storedFilename   String
  extension        String
  mimeType         String
  sizeBytes        Int
  sha256Hash       String
  storageProvider  String    @default("local")
  relativePath     String
  kind             String
  isPublic         Boolean   @default(false)
  uploadedBy       String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?

  references MediaReference[]

  @@index([sha256Hash])
  @@index([kind])
  @@index([deletedAt])
}

model MediaReference {
  id           String    @id @default(uuid())
  mediaFileId  String
  moduleName   String
  entityType   String
  entityId     String
  purpose      String
  displayOrder Int       @default(0)
  isPrimary    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?

  mediaFile MediaFile @relation(fields: [mediaFileId], references: [id])

  @@index([moduleName, entityType, entityId])
  @@index([mediaFileId])
  @@index([purpose])
  @@index([deletedAt])
}

/// Reserved / allocated barcode codes (inventory flows consume this later).
model Barcode {
  id          String    @id @default(uuid())
  code        String    @unique
  prefix      String
  status      String
  entityType  String?
  entityId    String?
  reservedAt  DateTime?
  allocatedAt DateTime?
  releasedAt  DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  @@index([prefix])
  @@index([status])
  @@index([entityType, entityId])
  @@index([deletedAt])
}

model SequenceCounter {
  prefix    String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

/// Append-only domain audit trail. Write only via AuditService.record.
model AuditLog {
  id         String   @id @default(uuid())
  module     String
  entityType String
  entityId   String?
  action     String
  oldValues  String?
  newValues  String?
  userId     String?
  username   String?
  ipAddress  String?
  metadata   String?
  message    String?
  createdAt  DateTime @default(now())

  @@index([module])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([userId])
  @@index([createdAt])
}