{
  "name": "@juman/backend-node",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "test:cov:shared": "vitest run --coverage --config vitest.shared.config.ts",
    "test:cov:customers": "vitest run --coverage --config vitest.customers.config.ts",
    "test:cov:media": "vitest run --coverage --config vitest.media.config.ts",
    "test:cov:barcode": "vitest run --coverage --config vitest.barcode.config.ts",
    "test:cov:inventory": "vitest run --coverage --config vitest.inventory.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.4.2",
    "multer": "2.0.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@swc/core": "1.15.47",
    "@types/express": "5.0.6",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.1",
    "@types/passport": "1.0.17",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "unplugin-swc": "1.5.9",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
