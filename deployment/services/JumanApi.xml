<!-- WinSW service definition for Juman FastAPI (venv python + run_api.py).
     Install after first-launch bootstrap creates backend\.venv
     Runs as LocalSystem so it can bind 127.0.0.1:8000 and read Program Files config. -->
<service>
  <id>JumanApi</id>
  <name>Juman API</name>
  <description>Juman FastAPI backend - waits for PostgreSQL then serves HTTP</description>
  <executable>%BASE%\.venv\Scripts\python.exe</executable>
  <arguments>run_api.py</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>8</keepFiles>
  </log>
  <onfailure action="restart" delay="10 sec"/>
  <onfailure action="restart" delay="30 sec"/>
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <depend>postgresql-x64-16</depend>
  <env name="JUMAN_INSTALL_DIR" value="%BASE%\.."/>
</service>
