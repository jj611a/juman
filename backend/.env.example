# Juman Backend Environment Configuration
# Copy this file to `.env` and adjust values for your environment.

# Application
APP_NAME=Juman
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
# Development may keep this placeholder. Production MUST set a long random secret
# (32+ chars). Startup will abort if APP_ENV=production and SECRET_KEY is missing,
# empty, or still set to an example/default value.
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins; use * only in development)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://juman:juman@localhost:5432/juman
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Phase 6 validation admin (CREATE/DROP DATABASE only — never point at app/prod DBs)
# DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
# JUMAN_KEEP_VALIDATION_DB=0
# JUMAN_POSTGRES_CERT=0
# PG_DUMP=

# JWT
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=juman
JWT_AUDIENCE=juman-desktop

# Password hashing (argon2)
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# Redis (optional — leave empty to disable)
REDIS_URL=
REDIS_ENABLED=false

# Logging
LOG_LEVEL=DEBUG
LOG_JSON=false

# Identity bootstrap (optional — create first Admin during `alembic upgrade`)
# IDENTITY_BOOTSTRAP_USERNAME=admin
# IDENTITY_BOOTSTRAP_PASSWORD=change-me-on-first-login

# Locale / business defaults (UI is Arabic; codes remain English)
DEFAULT_CURRENCY=IQD
DEFAULT_CURRENCY_SYMBOL=د.ع
DEFAULT_LOCALE=ar-IQ
DEFAULT_TIMEZONE=Asia/Baghdad
